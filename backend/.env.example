SARVAM_API_KEY=
DATABASE_URL=sqlite:///./carecompass.db
DEMO_PASSWORD=CareCompass-Demo-2026
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXP_MINUTES=720
USE_LLM=false
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_CONVO_MODEL=sarvam-105b-conversations
SARVAM_MAX_TOKENS=800
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=priya_hi_recovery
SARVAM_TIMEOUT_S=6
# PathoVision: leave vision keys blank until a vision-capable provider is configured.
# Sarvam's text models are never used to interpret images.
OPENAI_BASE=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash
# Optional override when a different vision model should be used.
OPENAI_VISION_MODEL=
PATHOVISION_TIMEOUT_S=50
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-3-5-haiku-latest
OCR_ENGINE=tesseract
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
EMERGENCY_THRESHOLD=0.25
FOLLOWUP_THRESHOLD=0.5
MAX_FOLLOWUPS=3
MATCH_TOP_K=3
RED_FLAG_LABEL_MODE=correct
