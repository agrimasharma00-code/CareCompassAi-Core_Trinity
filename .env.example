SARVAM_API_KEY=
USE_LLM=false
IMMEDIATE_THRESHOLD=0.25
MAX_DISTANCE_KM=15

# Optional booking SMS notifications. Leave disabled until a Twilio sender and verified test recipient are configured.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91

# PathoVision server-side configuration (never expose these in frontend variables).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OCR_ENGINE=tesseract
TESSERACT_CMD=
